# Copy this to .env for local development. Never commit the real .env.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ENABLE_LLM_FILTER=false
ENABLE_OLLAMA=false
LANGSMITH_TRACING=false
BHARATPULSE_POLL_SECONDS=300
# Public demo security (for local testing, leave disabled):
BHARATPULSE_PUBLIC_MODE=false
# Only enable public AI when you have set private API keys, quotas and billing alerts.
BHARATPULSE_PUBLIC_AI_ENABLED=false
# For a public Render app, this is provided by render.yaml:
# BHARATPULSE_DATA_DIR=/tmp/bharatpulse
# BHARATPULSE_ALLOWED_HOSTS=*.onrender.com,localhost,127.0.0.1
# Optional external permitted origin(s), comma separated:
# BHARATPULSE_ALLOWED_ORIGINS=https://bharatpulse-ai.onrender.com

# Optional no-paid-key targeted Google News RSS discovery. OFF by default.
# Enabled mode checks additional reporting only for explicit fresh/related-news queries.
BHARATPULSE_ENABLE_ON_DEMAND_RSS_SEARCH=false

# Optional publisher-host allowlist additions for permitted article reading.
# Only add publishers you are authorised to fetch; no arbitrary user URLs.
# BHARATPULSE_ARTICLE_DOMAINS=example-publisher.in,another-publisher.org

# Optional best-effort publisher link discovery for Google News RSS records.
# Uses public Bing News RSS only when its robots rules permit the lookup;
# does not fetch Google News article HTML or bypass publisher restrictions.
BHARATPULSE_BING_RSS_DISCOVERY=true

# Exact hosts for which you have permission to retain body text on disk.
BHARATPULSE_LICENSED_STORAGE_HOSTS=
