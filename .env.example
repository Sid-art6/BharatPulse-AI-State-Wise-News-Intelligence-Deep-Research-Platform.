# Save this file as .env in the bharatpulse-ai project root.
# NEVER send anyone your key or commit your .env file to GitHub.
LLM_PROVIDER=groq
GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE
# Currently supported Groq model (check https://console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-20b
# Set true to filter ONLY newly discovered news headlines using the LLM.
ENABLE_LLM_FILTER=true

# Optional local fallback: set LLM_PROVIDER=ollama and ENABLE_OLLAMA=true.
ENABLE_OLLAMA=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# RSS refresh every 5 minutes; minimum allowed 300 seconds.
BHARATPULSE_POLL_SECONDS=300
# BHARATPULSE_DATA_DIR=./data
