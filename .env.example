# Save this file as .env in the bharatpulse-ai project root.
# NEVER send anyone your key or commit your .env file to GitHub.
LLM_PROVIDER=groq
GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE
# Currently supported Groq model (check https://console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-20b
# Set true to filter ONLY newly discovered news headlines using the LLM.
ENABLE_LLM_FILTER=true

# Optional local fallback: set LLM_PROVIDER=ollama and ENABLE_OLLAMA=true.
ENABLE_OLLAMA=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# RSS refresh every 5 minutes; minimum allowed 300 seconds.
BHARATPULSE_POLL_SECONDS=300
# BHARATPULSE_DATA_DIR=./data

# v0.9 optional LangSmith observability. Generate your own key in LangSmith.
# Leave false until ready: tracing sends prompts, RSS excerpts and outputs to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=PASTE_YOUR_LANGSMITH_KEY_HERE
LANGSMITH_PROJECT=BharatPulse-v09-Research
# Optional for organisation-scoped keys:
# LANGSMITH_WORKSPACE_ID=your_workspace_id_here
# Optional for EU-hosted workspaces:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
